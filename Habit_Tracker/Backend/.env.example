# MongoDB Atlas connection string (required)
MONGODB_URI=

# Long random string used to sign JWTs (required)
JWT_SECRET=

# Defaults to 5000 if unset
PORT=5000

# Optional — without it, /api/ai/coach returns 503
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Optional — comma-separated allowed origins in production, e.g.:
# CLIENT_ORIGIN=https://your-app.netlify.app
CLIENT_ORIGIN=
